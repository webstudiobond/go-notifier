# ==============================================================================
# Docker Compose Environment Configuration (.env)
# ==============================================================================
# Infrastructure variables for Docker Compose interpolation.
# Download directly via:
#   curl -fsSL https://raw.githubusercontent.com/webstudiobond/go-notifier/main/example.env -o .env

# --- Mandatory Compose Interpolation Variables ---
# User and Group IDs matching your application worker process on the host
APP_UID=1000
APP_GID=1000

# Site / project identifier used in container_name and hostname
SITE_USER=myuser

# --- Optional Compose Variables ---
# Human-readable site name prefixed in notifications (defaults to SITE_USER)
SITE_NAME="My Application"

# Docker image version tag (defaults to latest)
GO_NOTIFIER_VERSION=latest
